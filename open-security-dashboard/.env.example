# Wildbox Security Dashboard - environment for `npm run dev` / `npm run build`
#
# Copy to .env.local. These are the variables the dashboard's code reads
# (src/lib/api-client.ts, src/app/layout.tsx). next.config.js also reads
# API_BASE_URL (target of the /api/proxy rewrite, which the app does not
# call), CORS_ORIGIN (Access-Control-Allow-Origin on /api/*) and CUSTOM_KEY
# (unused); none of them needs to be set.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# for the production image pass them as build arguments (see Dockerfile).

# Origin of the Wildbox gateway; every API call goes through it.
# Leave empty when the gateway serves the dashboard (the API is then called
# on the page's own origin). Set it when this dev server runs on another
# origin, for example https://localhost for the gateway of a local stack.
NEXT_PUBLIC_GATEWAY_URL=

# Call the API through the gateway (default). "false" only for development
# against a bare service.
NEXT_PUBLIC_USE_GATEWAY=true

# Public URL of the dashboard, for absolute links in page metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server side only: gateway URL for requests made during server rendering.
# The root docker-compose.yml sets it to http://open-security-gateway:8080.
# INTERNAL_GATEWAY_URL=
