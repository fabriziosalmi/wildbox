# Wildbox Open Security Automations Environment Configuration
# Copy this file to .env and customize the values for your environment.
#
# For the standalone docker-compose.yml in this directory. With the full
# stack (`docker compose --profile automations up -d` at the repository
# root) the same settings live in the root .env; see README.md.

# =============================================================================
# n8n Configuration
# =============================================================================

# There is no password to set here: n8n 1.x has no basic auth and ignores
# N8N_BASIC_AUTH_* (#714). Create n8n's owner account in the browser right
# after the first start; see README.md.

# n8n Server Configuration
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_LOG_LEVEL=info
TIMEZONE=UTC

# Webhook Configuration
WEBHOOK_URL=http://localhost:5678

# n8n keeps its data in SQLite, in its data volume. The DB_POSTGRESDB_*
# variables that were listed here are passed to no container by
# docker-compose.yml: setting them changed nothing (#665).

# Required by docker-compose.yml for its Redis.
REDIS_PASSWORD=

# =============================================================================
# Wildbox Platform Integration
# =============================================================================

# The gateway's HTTPS address, as n8n reaches it. Workflows call the API only
# through the gateway: the services do not accept calls made to them directly.
WILDBOX_API_GATEWAY_URL=https://open-security-gateway
# A personal API key (dashboard: Settings > API keys) with the read scope.
# Workflows send it in the X-API-Key header.
WILDBOX_API_KEY=  # REQUIRED

# =============================================================================
# Executive Security Dashboard workflow
# =============================================================================

# Slack incoming webhook the weekly summary is posted to.
SLACK_WEBHOOK_URL=
# Sender and recipient of the weekly report e-mail. The SMTP server is an n8n
# credential attached to the "Send Executive Email" node.
EXECUTIVE_REPORT_EMAIL_FROM=
EXECUTIVE_REPORT_EMAIL_TO=
