# Test Environment Configuration for CI/CD
# This file defines environment variables for integration tests

# Service URLs (defaults for CI environment)
IDENTITY_SERVICE_URL=http://localhost:8001
TOOLS_SERVICE_URL=http://localhost:8000
DATA_SERVICE_URL=http://localhost:8002
GUARDIAN_SERVICE_URL=http://localhost:8013
RESPONDER_SERVICE_URL=http://localhost:8018
AGENTS_SERVICE_URL=http://localhost:8006
CSPM_SERVICE_URL=http://localhost:8019
GATEWAY_SERVICE_URL=http://localhost:80

# Test credentials (SAFE FOR CI ONLY - DO NOT USE IN PRODUCTION)
TEST_ADMIN_EMAIL=admin@wildbox.io
TEST_ADMIN_PASSWORD=ChangeMe123!
TEST_API_KEY=test-api-key-for-ci-only

# The stack's own secrets, for the tests that sign a token or speak to a
# service as the gateway does: the values of the stack under test.
JWT_SECRET_KEY=test-jwt-secret-for-ci-only-not-for-production
GATEWAY_INTERNAL_SECRET=test-gateway-secret-ci

# Nothing else is read from this file: the database, Redis, feature-flag,
# logging and timeout lines it used to carry were read by no test (#665).
