    {"address": "127.0.0.1", "expect": "internal", "why": "loopback"},
    {"address": "127.255.0.9", "expect": "internal", "why": "loopback, the whole /8"},
    {"address": "10.0.0.1", "expect": "internal", "why": "RFC 1918"},
    {"address": "172.16.5.4", "expect": "internal", "why": "RFC 1918, where Docker puts its networks"},
