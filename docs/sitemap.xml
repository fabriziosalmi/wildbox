{%- for group in site.data.docs_nav %}
  {%- for item in group.items %}
    {%- if item.path %}
      {%- assign target = site.pages | where: "path", item.path | first %}
      {%- if target %}
  <url>
    <loc>{{ target.url | absolute_url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
      {%- endif %}
    {%- endif %}
  {%- endfor %}
{%- endfor %}
</urlset>
