---
# Generated by Jekyll at build time. Only <loc> is emitted: GitHub Pages
# cannot supply a real <lastmod> (jekyll-last-modified-at is not in its
# plugin whitelist), and invented changefreq/priority values add nothing.
# The standalone HTML pages are listed
# below by hand; every documentation page comes from _data/docs_nav.yml and is
# listed only if Jekyll actually rendered it, so the sitemap cannot point at a
# page that does not exist.
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.wildbox.io/</loc>
  </url>
  <url>
    <loc>https://www.wildbox.io/docs.html</loc>
  </url>
  <url>
    <loc>https://www.wildbox.io/api-reference.html</loc>
  </url>
  <url>
    <loc>https://www.wildbox.io/learn/</loc>
  </url>
  <url>
    <loc>https://www.wildbox.io/learn/how-to-check-spf-dkim-dmarc/</loc>
  </url>
  <url>
    <loc>https://www.wildbox.io/tools/</loc>
  </url>
  <url>
    <loc>https://www.wildbox.io/tools/jwt-decoder/</loc>
  </url>
  <url>
    <loc>https://www.wildbox.io/privacy.html</loc>
  </url>
{%- for group in site.data.docs_nav %}
  {%- for item in group.items %}
    {%- if item.path %}
      {%- assign target = site.pages | where: "path", item.path | first %}
      {%- if target %}
  <url>
    <loc>{{ target.url | absolute_url }}</loc>
  </url>
      {%- endif %}
    {%- endif %}
  {%- endfor %}
{%- endfor %}
</urlset>
