# ================================
# Wildbox Security API Configuration
# ================================

# Security Settings
# Required by app/config.py: at least 32 characters, at least 16 distinct
# characters, and none of the weak patterns it rejects (for example "key",
# "secret", "test", "123", "abc"). Replace the placeholder with a random value.
API_KEY=your-secure-api-key-here-please-change-this-to-something-secure

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database/Cache Settings
REDIS_URL=redis://localhost:6379

# Rate Limiting
# Reported by /api/system/info; the service does not enforce these values.
RATE_LIMIT_REQUESTS=500
RATE_LIMIT_WINDOW=60

# Tool Settings
TOOL_TIMEOUT=300
MAX_CONCURRENT_TOOLS=10

# External Services (if needed)
# VIRUSTOTAL_API_KEY=your-virustotal-api-key
# SHODAN_API_KEY=your-shodan-api-key

# Docker-specific overrides
# Uncomment these when running with Docker
# HOST=0.0.0.0
# REDIS_URL=redis://redis:6379
