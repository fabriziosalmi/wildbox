# Development Dockerfile with hot reload support
# Python 3.11 and the same digest as Dockerfile: this image was still 3.12,
# while requirements.txt is compiled for 3.11 and the production image and CI
# run 3.11 (WILDBO-BLD-04).
# Base image pinned by digest: a floating tag is republished upstream, so the
# same commit built a month apart produced a different interpreter patch level,
# a different OpenSSL and a different set of OS CVEs, with nothing recording
# which one shipped (WILDBO-BLD-01). Dependabot's docker ecosystem proposes
# digest bumps as reviewable PRs.
FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534
# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Install system dependencies including development tools
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    nmap \
    git \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies, as Dockerfile does.
COPY requirements.txt .
# --require-hashes: refuse to install an artefact whose hash does not match the
# lockfile (WILDBO-DEP-04). It was implied here by the hashes in the lockfile;
# now it is stated, so a lockfile without hashes fails instead of installing.
# pip is the one in the digest-pinned base image (24.0): no `--upgrade pip`,
# which installed whatever PyPI served that day, unhashed, and then ran it
# (#657). --no-build-isolation: a source distribution in the lockfile is built
# with the base image's setuptools instead of one downloaded for the build,
# so nothing is fetched that the lockfile does not name with a hash.
RUN pip install --no-cache-dir --require-hashes --no-build-isolation -r requirements.txt

# No separate reloader package: `uvicorn --reload` watches files with
# watchfiles, which uvicorn[standard] pins in the lockfile. The unpinned
# `pip install watchdog` that stood here installed a package nothing imports.

# Install the shared package, provided via the `shared` additional build
# context (see docker-compose.dev.yml). app/main.py imports it; without it the
# container exited at start with ModuleNotFoundError. Installed as in the
# production Dockerfile: with the extras of the modules the service imports
# and no --no-deps, so pip resolves what they require against what the
# hash-checked install above provided (--no-index leaves it nothing else) and
# the build fails when requirements.txt lacks one; `pip check` covers the
# rest (#722). --no-index --no-build-isolation: build it with the setuptools
# already in the image instead of one downloaded from PyPI, unhashed, at
# every build (#657).
COPY --from=shared . /tmp/open-security-shared
RUN pip install --no-cache-dir --no-index --no-build-isolation \
        "/tmp/open-security-shared[fastapi,metrics]" \
    && pip check

# Create app directory
RUN mkdir -p /app/logs

# Expose port
EXPOSE 8000

# Default command (will be overridden in docker-compose.dev.yml)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
