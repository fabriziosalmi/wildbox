# Open Security Sensor Configuration

# Data Lake Connection
# Batches go to the gateway, https://<gateway>/api/v1/data/ingest, which
# authenticates the key and forwards them to the data service under the key's
# team. See README.md, "Connecting the sensor to Wildbox".
data_lake:
  # The gateway URL (or the full .../api/v1/data/ingest URL). HTTPS only.
  # Overridden by SENSOR_DATA_LAKE_ENDPOINT.
  endpoint: "https://open-security-gateway"
  # An identity personal API key (wsk_...) of the team member created for the
  # sensor, with the data:ingest scope. Set it with SENSOR_DATA_LAKE_API_KEY,
  # not here. Unset, the sensor runs but forwards nothing.
  api_key: ""
  # Verify the gateway's certificate. Leave it on.
  tls_verify: true
  # PEM file to trust for the gateway's certificate, when no public CA signed
  # it. Overridden by SENSOR_DATA_LAKE_CA_BUNDLE.
  ca_bundle: ""
  # How this sensor is named in the data service. Defaults to the hostname.
  # Overridden by SENSOR_DATA_LAKE_SENSOR_ID.
  sensor_id: ""
  batch_size: 100
  flush_interval: 30
  timeout: 30
  # A batch the gateway does not take for a reason that may pass (a network
  # error, HTTP 429, a 5xx answer) is kept and sent again: after retry_delay
  # seconds, then twice as long each time, up to retry_max_delay.
  retry_delay: 5
  retry_max_delay: 300
  # What may wait for the gateway: this many events and this many bytes of
  # serialized events. When either is reached the sensor stops collecting
  # until a batch is accepted; it drops nothing to make room.
  buffer_max_events: 5000
  buffer_max_bytes: 16777216  # 16 MiB

# Telemetry Collection
collection:
  process_events: true
  network_connections: true
  file_monitoring: true
  user_events: true
  system_inventory: true
  # Forward logs. What is forwarded is the log_sources section below.
  log_forwarding: false

# Where the sensor keeps what must outlive a restart: the log forwarder's
# read positions (log-positions.json). In the container this is the
# sensor_data volume. Overridden by SENSOR_DATA_DIR. The directory must exist
# and be writable by the sensor's user; one sensor per directory. Without it
# positions are kept in memory only and read_from applies at every start.
data_dir: /var/lib/security-sensor

# Log sources: what the log forwarder reads when collection.log_forwarding is
# true. See README.md, "Log forwarding".
#
# Without this section the forwarder reads the platform's defaults: on Linux
# /var/log/syslog, /var/log/auth.log and the systemd journal; on macOS
# /var/log/system.log and the unified log; on Windows the Security, System
# and Application event logs. With it, exactly the sources it lists and
# nothing else ("log_sources: []" forwards no log).
#
# In the container these are the container's paths, and the compose files
# mount no host log: mount the directory read-only first, for example
# "/var/log/nginx:/host/var/log/nginx:ro", and name the mounted path here.
# Everything a source matches is sent to Wildbox: name log directories only.
#
# log_sources:
#   - name: nginx_access                      # the events' type is log.<name>
#     type: file                              # file (default), journald, windows_event, unified_log
#     path: /host/var/log/nginx/access.log    # absolute; a file or a pattern (*, ?, [])
#     format: nginx                           # syslog, nginx, apache or raw (default)
#     enabled: true                           # default true
#     read_from: end                          # end (default) or beginning: where
#                                             # to start the first time; later
#                                             # starts go on from data_dir
#   - name: app
#     path: /host/var/log/app/*.log
#   - name: journal
#     type: journald

# File Integrity Monitoring
fim:
  enabled: true
  paths:
    # Host paths (mounted as /host/*)
    - "/host/etc"
    - "/host/bin"
    - "/host/usr/bin"
    - "/host/opt"
  exclude_patterns:
    - "*.tmp"
    - "*.log"
    - "*.cache"
    - "*.pid"
    - "*.lock"
  recursive: true
  max_depth: 10

# Performance Tuning
performance:
  query_interval: 10
  max_memory_mb: 128
  max_cpu_percent: 5
  max_queue_size: 1000
  worker_threads: 4

# Logging Configuration
logging:
  level: "INFO"
  file: "/var/log/security-sensor/sensor.log"  # Set to null to disable file logging
  max_size: 10485760  # 10MB
  backup_count: 5
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Network Configuration
network:
  bind_address: "0.0.0.0"  # Bind to all interfaces for Docker
  bind_port: 8004
  enable_api: true
  api_key: null  # Set to require API key authentication
