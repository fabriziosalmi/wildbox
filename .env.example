# Wildbox Security Platform - Environment Configuration
# =====================================================
# SECURITY WARNING: Never commit actual secrets to version control!
# Copy this file to .env and update with your actual values

# Identity Service Configuration
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@postgres:5432/identity
REDIS_URL=redis://wildbox-redis:6379/0

# Security Keys (CHANGE THESE!)
# CRITICAL: JWT_SECRET_KEY must match across all services for token validation!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate-a-secure-random-jwt-secret-key-here
ENCRYPTION_KEY=generate-a-secure-encryption-key-here

# Admin Configuration
CREATE_INITIAL_ADMIN=true
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=Change-This-To-A-Secure-Password!

# API Keys (IMPORTANT: Generate a secure random key for this)
# Example: openssl rand -hex 32
API_KEY=replace-this-with-a-secure-random-string-32-chars-long

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production
CORS_ORIGINS=https://yourdomain.com,https://dashboard.yourdomain.com

# Database Passwords
# PostgreSQL Database Configuration (CRITICAL!)
# All service DATABASE_URLs inherit from POSTGRES_PASSWORD
# Generate a secure password: openssl rand -base64 32
POSTGRES_PASSWORD=generate-secure-database-password
POSTGRES_USER=postgres
POSTGRES_DB=identity

# Guardian Service
GUARDIAN_SECRET_KEY=generate-guardian-secret-key
GUARDIAN_DB_PASSWORD=generate-guardian-db-password

# CSPM Service (Django SECRET_KEY, min 32 chars)
CSPM_SECRET_KEY=generate-cspm-secret-key-min-32-characters

# Authenticates callers of the sensor's local API. Without it the sensor starts
# but answers 503 on every route except /health.
SENSOR_API_KEY=

# Application secret for the data service (passed as SECRET_KEY). Its config
# refuses to start without one when ENVIRONMENT=production, which is the
# default in this template.
DATA_SECRET_KEY=
# Guardian uses its own database (provisioned by scripts/init-databases.sql).
# Must use the same POSTGRES_PASSWORD as above. (psycopg2/Django driver — no +asyncpg.)
GUARDIAN_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/guardian

# Data service — its own database (psycopg2, sync; provisioned by init-databases.sql)
DATA_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/data

# Responder does not use a database, but the compose passes this var; leave set.
RESPONDER_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/responder

# Agents LLM — Claude (Anthropic). Set your key to enable AI threat analysis;
# leave empty and the agents service still starts (analysis fails gracefully).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# Gateway Configuration (CRITICAL for production!)
# Used for secure internal service-to-service communication
# Generate with: openssl rand -hex 32
GATEWAY_INTERNAL_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-SECRET

# N8N Automation Service
# Generate with: openssl rand -base64 24
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE-THIS-TO-SECURE-PASSWORD
# Encrypts n8n credentials at rest. generate-secrets produced it but the
# template never declared it, so it was appended at the end of .env instead of
# sitting with the other n8n settings.
N8N_ENCRYPTION_KEY=

# Next.js Dashboard Authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE-THIS-TO-SECURE-NEXTAUTH-SECRET

# Grafana Monitoring
# Generate secure password for Grafana admin user
GRAFANA_ADMIN_PASSWORD=CHANGE-THIS-TO-SECURE-GRAFANA-PASSWORD

# Security Settings
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_MFA=false

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# REDIS (REQUIRED)
# =============================================================================
# Shared by the tools/guardian/responder/cspm/agents Celery & Dramatiq brokers.
# Compose fails to start without it (no insecure default). Generate with:
#   openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_generate_a_secure_redis_password

# Celery Flower UI basic-auth (bound to 127.0.0.1, still set real values).
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_generate_a_secure_flower_password

# Django ALLOWED_HOSTS for the guardian service (required in production).
ALLOWED_HOSTS=localhost,127.0.0.1

# ═══════════════════════════════════════════════════════════════════════════
# Added by the audit remediation
# ═══════════════════════════════════════════════════════════════════════════

# Encrypts cloud credentials before CSPM writes them to Redis, so they are not
# recoverable from the append-only file on the Redis volume (WILDBO-SEC-02).
# REQUIRED: the CSPM service refuses to start a scan without it.
CSPM_CREDENTIAL_KEY=generate-with-make-generate-secrets

# Keys the HMAC used to store API-key digests. Kept SEPARATE from
# JWT_SECRET_KEY so that rotating the JWT signing key does not invalidate every
# API key in the database (WILDBO-SEC-01). If unset, the JWT key is used and
# the two remain coupled; scripts/rotate_secrets.sh --secret API_KEY_HASH_SECRET
# --init seeds it safely for an existing deployment.
API_KEY_HASH_SECRET=generate-with-make-generate-secrets

# Per-team request budget enforced at the gateway, in requests per hour. The
# gateway default is 10000; it used to be 1000000, which never engaged
# (WILDBO-SCAL-03).
RATE_LIMIT_PER_HOUR=10000

# Redis memory ceiling. The instance holds authoritative state, so its policy is
# noeviction: an over-capacity write fails loudly instead of silently deleting
# somebody's scan (WILDBO-DATA-04).
REDIS_MAXMEMORY=1gb

# Merged from the former .env.template, which had drifted from this file:
# make setup copied .env.example while make generate-secrets read
# .env.template, so which variables you ended up with depended on which
# command you happened to run.
NEXT_PUBLIC_GATEWAY_URL=http://localhost
NEXT_PUBLIC_USE_GATEWAY=true
RATE_LIMIT_REQUESTS=500
RATE_LIMIT_WINDOW=60
