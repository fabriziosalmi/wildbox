# Wildbox Security Platform - Environment Configuration
# =====================================================
# SECURITY WARNING: Never commit actual secrets to version control!
# Copy this file to .env and update with your actual values

# Identity Service Configuration
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@postgres:5432/identity
# No REDIS_URL here: docker-compose.yml builds each service's Redis URL with
# REDIS_PASSWORD (identity can be overridden with IDENTITY_REDIS_URL).

# Security Keys (CHANGE THESE!)
# CRITICAL: JWT_SECRET_KEY must match across all services for token validation!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate-a-secure-random-jwt-secret-key-here

# Admin Configuration
CREATE_INITIAL_ADMIN=true
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=Change-This-To-A-Secure-Password!

# API Keys (IMPORTANT: Generate a secure random key for this)
# Example: openssl rand -hex 32
# Required by the tools service at start-up. It is not a request credential:
# the tools service accepts only requests forwarded by the gateway (#565).
API_KEY=replace-this-with-a-secure-random-string-32-chars-long

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
# Required: Compose refuses to start without it. production, staging or
# development. Only development is a development stack: it serves the API
# schemas and may run without the secrets the services check at start-up.
# Anything else is held to those checks.
ENVIRONMENT=production
CORS_ORIGINS=https://yourdomain.com,https://dashboard.yourdomain.com

# Database Passwords
# PostgreSQL Database Configuration (CRITICAL!)
# All service DATABASE_URLs inherit from POSTGRES_PASSWORD
# Generate a secure password: openssl rand -base64 32
POSTGRES_PASSWORD=generate-secure-database-password
POSTGRES_USER=postgres
POSTGRES_DB=identity

# Guardian Service
GUARDIAN_SECRET_KEY=generate-guardian-secret-key
GUARDIAN_DB_PASSWORD=generate-guardian-db-password

# CSPM Service (Django SECRET_KEY, min 32 chars)
CSPM_SECRET_KEY=generate-cspm-secret-key-min-32-characters

# Authenticates callers of the sensor's local API. Without it the sensor starts
# but answers 503 on every route except /health.
SENSOR_API_KEY=

# How the sensor sends telemetry: through the gateway, with a personal API key
# (Settings > API keys) of the team member created for the sensor, scoped to
# data:ingest; the telemetry is stored under that member's team. Empty, the
# sensor runs and forwards nothing. See open-security-sensor/README.md.
SENSOR_DATA_LAKE_API_KEY=
# The gateway's HTTPS address as the sensor reaches it, and the certificate it
# trusts for it. The defaults suit the development certificate the gateway
# generates; set the bundle to an empty value to use the system trust store.
# SENSOR_DATA_LAKE_ENDPOINT=https://open-security-gateway
# SENSOR_DATA_LAKE_CA_BUNDLE=/etc/ssl/wildbox/wildbox.crt
# The sensor's name in the data service, unique within its team.
# SENSOR_DATA_LAKE_SENSOR_ID=open-security-sensor

# Application secret for the data service (passed as SECRET_KEY). Its config
# refuses to start without one unless ENVIRONMENT=development; this template
# says production.
DATA_SECRET_KEY=
# Guardian uses its own database (provisioned by scripts/init-databases.sql).
# Must use the same POSTGRES_PASSWORD as above. (psycopg2/Django driver — no +asyncpg.)
GUARDIAN_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/guardian

# Data service — its own database (psycopg2, sync; provisioned by init-databases.sql)
DATA_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/data

# Agents LLM — Claude (Anthropic). Set your key to enable AI threat analysis;
# leave empty and the agents service still starts (analysis fails gracefully).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# Analyses each user may submit, and an optional ceiling for a whole team
# (empty: none), in the `limits` notation, e.g. 5/minute;50/day. The agents
# service refuses to start on a value it cannot parse.
# ANALYZE_RATE_LIMIT=5/minute
# ANALYZE_TEAM_RATE_LIMIT=
# Team-data tools the AI analysis may use, comma-separated. OFF unless set:
# by default the model reads nothing Wildbox holds for your team.
#   threat_intel_query_tool    your team's threat indicators + shared feeds
#   vulnerability_search_tool  the vulnerabilities Guardian records on your
#                              team's assets (titles, CVE IDs, asset names)
# Setting it (1) sends what the tool returns to Anthropic with the rest of
# the conversation, and (2) puts it in the model's context beside text
# fetched from the internet, which can be written to instruct the model to
# pass that data out through another tool's arguments; the prompt asks the
# model not to, which is not a control. Read "Giving the AI analysis your
# team's data" in docs/guides/deployment.md first. Any other value stops
# the agents service at start.
# AGENT_TEAM_DATA_TOOLS=threat_intel_query_tool,vulnerability_search_tool
# Where those two tools reach the data service and guardian. The defaults
# are their addresses in docker-compose.yml; change them only if you run
# those services elsewhere.
# AGENTS_WILDBOX_DATA_URL=http://open-security-data:8002
# AGENTS_WILDBOX_GUARDIAN_URL=http://open-security-guardian:8013

# Gateway Configuration (CRITICAL for production!)
# Used for secure internal service-to-service communication
# Generate with: openssl rand -hex 32
GATEWAY_INTERNAL_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-SECRET

# N8N Automation Service
# No password here: n8n 1.x has no basic auth and ignored N8N_BASIC_AUTH_*
# (#714). Create n8n's owner account in the browser right after the first
# start; see open-security-automations/README.md.
# Encrypts n8n credentials at rest. generate-secrets produced it but the
# template never declared it, so it was appended at the end of .env instead of
# sitting with the other n8n settings.
N8N_ENCRYPTION_KEY=
# Read by the workflows in open-security-automations/workflows; see its
# README. A personal API key (Settings > API keys) with the read scope: the
# workflows send it to the gateway in X-API-Key.
AUTOMATIONS_WILDBOX_API_KEY=
# The gateway's HTTPS address as n8n reaches it. The default suits the
# development certificate the gateway generates.
# WILDBOX_API_GATEWAY_URL=https://open-security-gateway
# Where the weekly executive report goes (Slack incoming webhook, e-mail).
SLACK_WEBHOOK_URL=
EXECUTIVE_REPORT_EMAIL_FROM=
EXECUTIVE_REPORT_EMAIL_TO=

# Next.js Dashboard Authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE-THIS-TO-SECURE-NEXTAUTH-SECRET

# Grafana Monitoring
# Generate secure password for Grafana admin user
GRAFANA_ADMIN_PASSWORD=CHANGE-THIS-TO-SECURE-GRAFANA-PASSWORD

# Security Settings
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_MFA=false

# Monitoring. There is no switch and no port to set for metrics: every service
# that has a /metrics route always serves it, on its own port. ENABLE_METRICS
# and METRICS_PORT used to be here; no Compose file passed either to a
# container, so setting them changed nothing (#743).
#
# Alerting (docker compose --profile monitoring; docs/guides/deployment.md,
# section 7). None of these is a secret, and no secret goes in this file:
# Alertmanager reads passwords and webhook URLs from files in
# ALERTMANAGER_SECRETS_DIR, named by its configuration (smtp_auth_password_file,
# url_file).
#
# The Alertmanager configuration to mount. The default notifies NOBODY:
# alerts are shown in the Alertmanager and Prometheus UIs only. Point this at
# your copy of monitoring/examples/alertmanager-email.yml or
# alertmanager-webhook.yml to be notified.
# ALERTMANAGER_CONFIG_FILE=./monitoring/alertmanager.yml
# The directory of secret files, mounted read-only at
# /etc/alertmanager/secrets. Files must be readable by UID 65534.
# ALERTMANAGER_SECRETS_DIR=./monitoring/secrets
# The addresses the two UIs are reached at, for the links in notifications.
# ALERTMANAGER_EXTERNAL_URL=http://127.0.0.1:9093
# PROMETHEUS_EXTERNAL_URL=http://127.0.0.1:9090

# =============================================================================
# REDIS (REQUIRED)
# =============================================================================
# Shared by the tools/guardian/responder/cspm/agents Celery & Dramatiq brokers.
# Compose fails to start without it (no insecure default). Generate with:
#   openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_generate_a_secure_redis_password

# Celery Flower UI basic-auth (bound to 127.0.0.1, still set real values).
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_generate_a_secure_flower_password

# Django ALLOWED_HOSTS for the guardian service (required in production).
ALLOWED_HOSTS=localhost,127.0.0.1

# guardian's periodic tasks (guardian-beat). Unset = the default in
# open-security-guardian/guardian/schedule.py; a number of seconds, five
# crontab fields (UTC), or "off". Restart guardian-beat after a change.
# Defaults and the reasons for them: docs/guides/deployment.md.
# GUARDIAN_SCHEDULE_SLA_CHECK=900
# GUARDIAN_SCHEDULE_ALERT_RULES=900
# GUARDIAN_SCHEDULE_RISK_SCORES="0 2 * * *"
# GUARDIAN_SCHEDULE_REPORT_CLEANUP="0 3 * * *"
# GUARDIAN_SCHEDULE_HISTORY_CLEANUP="30 3 * * *"
# GUARDIAN_SCHEDULE_ASSET_INVENTORY="30 4 * * *"
# GUARDIAN_SCHEDULE_OVERDUE_ASSESSMENTS="0 8 * * *"
# GUARDIAN_SCHEDULE_EXPIRING_EXCEPTIONS="0 8 * * 1"
# How often the discovery rules and report schedules users define are
# checked for runs that are due.
# GUARDIAN_SCHEDULE_USER_SCHEDULES=60
# guardian's e-mail (SLA violations, assignments, alert rules, scheduled
# reports, compliance). GUARDIAN_EMAIL_HOST empty means no mail server: no
# e-mail is sent, and each notification is recorded as not sent. With a host,
# GUARDIAN_DEFAULT_FROM_EMAIL is required; an invalid value stops
# guardian-worker at start-up. Restart guardian-worker after a change.
# GUARDIAN_EMAIL_HOST=smtp.example.com
# GUARDIAN_EMAIL_PORT=587
# STARTTLS (usually port 587) or TLS from the start (usually 465): one of them.
# GUARDIAN_EMAIL_USE_TLS=true
# GUARDIAN_EMAIL_USE_SSL=false
# GUARDIAN_EMAIL_HOST_USER=
# GUARDIAN_EMAIL_HOST_PASSWORD=
# GUARDIAN_DEFAULT_FROM_EMAIL=Wildbox Guardian <guardian@example.com>
# What guardian-worker presents to identity to learn who may be e-mailed about
# a team: an assignee's address, the owners and admins. guardian keeps no
# address itself. A value of its own, never GATEWAY_INTERNAL_SECRET's (identity
# does not start if they are equal); `make generate-secrets` writes one.
# Empty, guardian e-mails only the addresses typed into an alert rule or a
# report schedule. On an existing deployment: openssl rand -hex 32
GUARDIAN_CONTACTS_SECRET=
# Where guardian-worker asks. Leave it unset.
# GUARDIAN_TEAM_CONTACTS_URL=http://open-security-identity:8001/internal/team-contacts
# The address users open the dashboard at, scheme and host only
# (https://wildbox.example.com): what a link in guardian's e-mails starts
# with. Unset, the e-mails carry no link.
# GUARDIAN_BASE_URL=
# Seconds before an alert rule that keeps firing notifies again, or "off" to
# notify only when it starts firing and when it recovers.
# GUARDIAN_ALERT_RENOTIFY_INTERVAL=86400
# Days a user stays one of a team's users in guardian without making a request
# in the team, 1 to 365. identity also tells guardian when a member is removed,
# which takes effect at once; this is what holds if that notice is lost.
# GUARDIAN_TEAM_MEMBERSHIP_MAX_AGE_DAYS=30
# Where identity tells guardian that a member left a team. Leave it unset.
# Set it to an empty value only if this deployment does not run guardian.
# GUARDIAN_INTERNAL_URL=http://open-security-guardian:8013/internal/team-memberships/revoke/
# Requests one user may make to guardian per period, under the gateway's
# per-team RATE_LIMIT_PER_HOUR: <count>/<period> with a period of second,
# minute, hour or day, or "off" to leave the gateway's limit alone. With any
# other value guardian does not start. Restart guardian after a change.
# GUARDIAN_RATE_LIMIT_USER=1000/hour
# Internal targets guardian may scan (#748). Asset discovery and port scans
# connect from guardian-worker, which sits inside the stack's networks, so
# they refuse private, loopback, link-local, multicast, reserved, shared and
# cloud-metadata addresses, and any range that contains one. Empty: nothing
# internal is scanned, your own LAN included. To scan it, list its CIDR ranges
# and IP addresses, comma-separated, for example 192.168.50.0/24,10.20.0.0/16
# (no host names: guardian scans addresses). Do not list the stack's own
# Docker networks. This is guardian's list: TOOLS_ALLOWED_INTERNAL_TARGETS,
# below, is the tools service's and guardian does not read it. A bad entry
# stops guardian and guardian-worker at start-up. Recreate both after a change.
GUARDIAN_ALLOWED_INTERNAL_TARGETS=

# ═══════════════════════════════════════════════════════════════════════════
# Added by the audit remediation
# ═══════════════════════════════════════════════════════════════════════════

# Encrypts cloud credentials before CSPM writes them to Redis, so they are not
# recoverable from the append-only file on the Redis volume (WILDBO-SEC-02).
# REQUIRED: the CSPM service refuses to start a scan without it.
CSPM_CREDENTIAL_KEY=generate-with-make-generate-secrets

# Days CSPM keeps a scan in Redis: its metadata, its entry in the team's scan
# index and, once it completes, its report, which the compliance pages and
# the cloud security overview are built from. A whole number from 1 to 3650;
# the service refuses to start otherwise. Redis runs with noeviction, so size
# REDIS_MAXMEMORY for it: about 100 bytes per check result per scan kept (see
# "Scan retention and Redis memory" in open-security-cspm/README.md).
# CSPM_REPORT_RETENTION_DAYS=90

# Seconds one CSPM scan may run before the worker stops it (120 to 86400; the
# service refuses to start otherwise). cspm-worker is also given this long to
# finish its scans when it is stopped, so `docker compose stop` or `down` can
# wait up to this long while a scan runs.
# CSPM_SCAN_TIMEOUT_SECONDS=3600

# Keys the HMAC used to store API-key digests. Kept SEPARATE from
# JWT_SECRET_KEY so that rotating the JWT signing key does not invalidate every
# API key in the database (WILDBO-SEC-01). Required: compose refuses to start
# without it, and identity refuses to start without it unless
# ENVIRONMENT=development. An EXISTING deployment must not take a fresh value:
# its stored digests are keyed by JWT_SECRET_KEY, so seed this from it once
# with `make init-api-key-hash` before upgrading (UPGRADING.md, #648).
API_KEY_HASH_SECRET=generate-with-make-generate-secrets

# Per-team request budget enforced at the gateway, in requests per hour. The
# gateway default is 10000; it used to be 1000000, which never engaged
# (WILDBO-SCAL-03). A whole number from 1 to 1000000000; with any other value
# the gateway does not start.
RATE_LIMIT_PER_HOUR=10000

# Redis memory ceiling. The instance holds authoritative state, so its policy is
# noeviction: an over-capacity write fails loudly instead of silently deleting
# somebody's scan (WILDBO-DATA-04).
REDIS_MAXMEMORY=1gb
# The container's memory limit. Keep it at least twice REDIS_MAXMEMORY: an AOF
# rewrite forks and can double Redis's resident memory, and a container killed
# by the kernel loses the writes noeviction would have refused (#530).
# Check with: python3 scripts/check_redis_config.py config --env-file .env
REDIS_MEMORY_LIMIT=2g

# Merged from the former .env.template, which had drifted from this file:
# make setup copied .env.example while make generate-secrets read
# .env.template, so which variables you ended up with depended on which
# command you happened to run.
#
# The origin the browser calls the API on. Leave it empty: the gateway serves
# the dashboard, and an empty value makes the dashboard call the API on the
# origin it was loaded from, whatever host name that is. Set it (to an
# https:// origin) only when the dashboard is served from a different origin
# than the gateway. It was http://localhost, where the gateway answers only
# /health and redirects everything else, so every API call failed (#103).
# NEXT_PUBLIC_* is compiled into the dashboard's browser code: the production
# image reads these when it is built, so rebuild it after a change (#559).
NEXT_PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_USE_GATEWAY=true
# Public URL of the dashboard, for absolute links in page metadata (optional).
NEXT_PUBLIC_APP_URL=

# Internal targets the network tools may scan (#614). The tools that take a
# host, an address or a range (port and vulnerability scanners, TLS and
# certificate analyzers, network_scanner, iot_security_scanner,
# database_security_analyzer, dns_enumerator's DNS servers, image registries)
# refuse private, loopback, link-local, multicast, reserved and shared
# addresses, ranges and names that resolve to them, and the stack's own
# service names. Empty: nothing internal is scanned. To scan a lab, list its
# CIDR ranges, IP addresses and host names, comma-separated, for example
# 10.20.0.0/16,192.168.50.0/24,lab-dc01. Do not list the stack's own Docker
# networks. A bad entry stops the tools service and its worker at start-up.
# See open-security-tools/README.md, "Network targets".
TOOLS_ALLOWED_INTERNAL_TARGETS=
