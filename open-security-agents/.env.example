# Anthropic (Claude). Without a key the service starts, but analyses fail.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Wildbox Services URLs
WILDBOX_API_URL=http://localhost:8000
WILDBOX_DATA_URL=http://localhost:8002
WILDBOX_GUARDIAN_URL=http://localhost:8013

# Application Settings
LOG_LEVEL=INFO

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Internal service communication: the proof-of-origin secret sent with the
# caller's identity on every internal tool call. REQUIRED; use the same value
# as the gateway and the other services.
GATEWAY_INTERNAL_SECRET=

# Analysis Settings
MAX_ANALYSIS_TIME_MINUTES=10
