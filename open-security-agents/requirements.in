# Direct dependencies for the agents service.
#
# This file is the INPUT. The lockfile is requirements.txt, generated by:
#
#     uv pip compile --generate-hashes requirements.in -o requirements.txt
#
# or, for every service at once, `make lock` from the repository root.
#
# Only the identity service used to have this split. Everywhere else the
# transitive tree was resolved fresh at each image build, so two builds of the
# same commit installed different code and the resolver was free to pick
# versions nobody had reviewed -- which is how a 2014 ecdsa release ended up on
# the token-verification path (WILDBO-DEP-02/DEP-04/DEP-05).

# One FastAPI line for every service. They used to be pinned at three different
# versions (0.104.1, 0.115.5, >=0.116), which dragged in three different
# Starlette versions each with its own advisories, so a fix applied to one
# service did not reach the others (WILDBO-DEP-01).
fastapi>=0.116.0,<1.0.0
uvicorn[standard]==0.32.1
pydantic==2.10.3
pydantic-settings==2.10.1
slowapi==0.1.9  # rate limiting; imported in app/main.py
celery[redis]==5.4.0
redis==5.2.1
# LangChain 1.x moved AgentExecutor and create_tool_calling_agent, which the
# threat enrichment agent is built on, out of `langchain` into
# `langchain-classic`; prompts, messages and @tool come from langchain-core.
# langchain-community was never imported and pinned langchain below 1.0.
langchain-classic==1.0.8
langchain-anthropic==1.4.6
httpx==0.28.1
python-dotenv==1.2.2

# No test runner and no linter: the lock made from this file is what the
# image installs. pytest, pytest-asyncio and black were named here, so the
# image shipped them with everything they bring (#788). The unit-test job
# installs pytest and its plugins on top of this lock
# (.github/workflows/test.yml), at the versions
# tests/ci-tools/requirements.in gives; the Code Quality job installs the
# linters from that lock.

# The service calls install_observability() and monitoring/prometheus.yml lists
# it as a scrape target, but without this package the shared helper falls back
# to no-op metrics and /metrics answers "prometheus_client is not installed" --
# a target Prometheus polls forever and never gets a series from.
# The floor is the one the shared package's `metrics` extra declares.
prometheus-client>=0.20,<1.0.0
