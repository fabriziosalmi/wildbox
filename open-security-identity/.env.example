# .env.example for open-security-identity

# The environment. Only "development" is a development environment: the API
# docs are served and API_KEY_HASH_SECRET may be left out. With any other
# value, or none, the service refuses to start without API_KEY_HASH_SECRET.
ENVIRONMENT=development

# Database Configuration
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT Secret Key
# IMPORTANT: Change this to a strong, randomly generated secret in production.
# You can generate one using: openssl rand -base64 32
JWT_SECRET_KEY="your-super-secret-jwt-key-here"

# For development/testing, use test keys. For production, use live keys.

# Other environment variables can be added here
# For example:
# DEBUG=True
# API_BASE_URL="http://localhost:8000"