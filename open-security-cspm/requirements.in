# Direct dependencies for the cspm service.
#
# This file is the INPUT. The lockfile is requirements.txt, generated by:
#
#     uv pip compile --generate-hashes requirements.in -o requirements.txt
#
# or, for every service at once, `make lock` from the repository root.
#
# Only the identity service used to have this split. Everywhere else the
# transitive tree was resolved fresh at each image build, so two builds of the
# same commit installed different code and the resolver was free to pick
# versions nobody had reviewed -- which is how a 2014 ecdsa release ended up on
# the token-verification path (WILDBO-DEP-02/DEP-04/DEP-05).

# One FastAPI line for every service. They used to be pinned at three different
# versions (0.104.1, 0.115.5, >=0.116), which dragged in three different
# Starlette versions each with its own advisories, so a fix applied to one
# service did not reach the others (WILDBO-DEP-01).
fastapi>=0.116.0,<1.0.0
uvicorn[standard]==0.24.0
celery[redis]==5.3.1
redis==5.0.1
boto3==1.34.63
botocore==1.34.63
# AWS is the only provider the service scans: it refuses the others (#624),
# and since then nothing imports google.auth or azure.identity, which were
# declared here for the worker's sessions. They are gone, with the Google and
# Azure SDK pins removed before them (#415, #665). Add an SDK back together
# with the check that imports it.
# Pydantic was pinned to 2.5.0 (November 2023). That single pin held FastAPI at
# 0.125 and Starlette at 0.50 in this service's lock, while the other services
# resolved to Starlette 1.6 -- three Starlette majors across one deployment,
# with the ASGI behaviour and the security fixes differing between them
# (WILDBO-DEP-01). Ranged so the whole platform converges on one resolution.
pydantic>=2.10.0,<3.0.0
pydantic-settings>=2.6.0,<3.0.0
pyyaml==6.0.1
httpx==0.25.2
cryptography==50.0.2
# The shared package's `metrics` extra (install_observability) requires
# prometheus-client 0.20 or later; the image build resolves the extra
# against this lock and fails below that floor (#722).
prometheus-client>=0.20,<1.0.0
python-dotenv==1.2.2
