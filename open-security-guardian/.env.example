# Open Security Guardian - environment for a guardian run from this directory
#
# guardian/settings.py loads a .env file from here (python-dotenv), then reads
# the environment. Every variable below is one guardian's code reads; a
# variable that is not here is not a setting. In the full stack the same
# settings come from the root .env through docker-compose.yml, some under a
# GUARDIAN_ prefix (EMAIL_HOST is GUARDIAN_EMAIL_HOST there): see the root
# .env.example.

# =============================================================================
# DJANGO
# =============================================================================

# Required. Generate one: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-make-it-long-and-random-at-least-50-characters

# Development mode: the API schema pages (/docs/, /redoc/, /api/schema/),
# Django's debug pages, no HTTPS redirect. false unless set to true.
DEBUG=false

# Host names guardian answers to, comma-separated. In the stack the gateway
# sends open-security-guardian.
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE, REDIS, CELERY
# =============================================================================

# postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://guardian:CHANGE_ME@localhost:5432/guardian
# Seconds a database connection is kept open.
# DATABASE_CONN_MAX_AGE=300

REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_TIMEZONE=UTC

# For docker-compose.yml in this directory only: the passwords of its own
# PostgreSQL and Redis. It builds DATABASE_URL and the Redis URLs from them.
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=

# =============================================================================
# THE GATEWAY
# =============================================================================

# Required. guardian accepts only requests that carry it with the caller's
# identity, as the gateway forwards them. The same value as the gateway's.
GATEWAY_INTERNAL_SECRET=

# Requests one user may make per period: <count>/<period> with a period of
# second, minute, hour or day, or "off". With any other value guardian does
# not start. API_RATE_LIMIT, its former name, is read when this one is unset.
GUARDIAN_RATE_LIMIT_USER=1000/hour

# Days a user stays one of a team's users without making a request in the
# team, 1 to 365. identity also tells guardian when a member is removed, which
# takes effect at once; this is what holds if that notice is lost.
# GUARDIAN_TEAM_MEMBERSHIP_MAX_AGE_DAYS=30

# Internal ranges asset discovery and port scans may reach: CIDR ranges and IP
# addresses, comma-separated (192.168.50.0/24,10.20.0.0/16). Empty: no private,
# loopback, link-local, reserved or cloud-metadata address is scanned. With a
# malformed entry guardian and its worker do not start.
GUARDIAN_ALLOWED_INTERNAL_TARGETS=

# The origins a browser may call guardian from, each written
# scheme://host[:port]: separated by commas, or as a JSON list
# (["https://a.example.com", "https://b.example.com"]). The same two forms,
# and the same rules, as the gateway's CORS_ORIGINS, which is the value the
# production overlay passes here. Unset: the development origins (localhost
# and 127.0.0.1 on ports 80, 3000 and 8000). Set and empty, or []: none,
# which is right behind the gateway. An entry that is not an origin (a
# wildcard, a path, a trailing slash, a host with no scheme) stops guardian
# at start-up.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# E-MAIL
# =============================================================================

# guardian sends e-mail by SMTP, or not at all: EMAIL_BACKEND is not read.
# EMAIL_HOST empty means no mail server, and every notification is then
# recorded as not sent, with that reason. Every value is checked at start-up
# (guardian/mailconf.py); an invalid one stops guardian.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
# STARTTLS (usually port 587) or TLS from the start (usually 465): one of them.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Both, or neither for a server that takes mail without a login.
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# The sender. Required with EMAIL_HOST.
DEFAULT_FROM_EMAIL=Wildbox Guardian <guardian@example.com>

# Notification recipients: there is no platform-wide list, by design. An
# alert rule and a report schedule e-mail the recipients their team gave
# them; an SLA violation and an assignment e-mail the vulnerability's
# assignee; everything without a recipient of its own goes to the owners and
# admins of the team it is about. guardian keeps no address: it asks identity
# who may be e-mailed about a team, with a secret of its own (not
# GATEWAY_INTERNAL_SECRET), which identity must be given too. Without it
# guardian e-mails only the addresses typed into a rule or a schedule.
# DEFAULT_NOTIFICATION_RECIPIENTS and SECURITY_TEAM_EMAIL are not read.
GUARDIAN_CONTACTS_SECRET=
# GUARDIAN_TEAM_CONTACTS_URL=http://open-security-identity:8001/internal/team-contacts

# The address users open the dashboard at, scheme and host only: what a link
# in an e-mail starts with. Unset, the e-mails carry no link.
# GUARDIAN_BASE_URL=https://wildbox.example.com

# Seconds before an alert rule that keeps firing notifies again, or "off" to
# notify only when it starts firing and when it recovers.
# GUARDIAN_ALERT_RENOTIFY_INTERVAL=86400

# =============================================================================
# PERIODIC TASKS (guardian-beat)
# =============================================================================

# Unset = the default in guardian/schedule.py; a number of seconds, five
# crontab fields (UTC), or "off".
# GUARDIAN_SCHEDULE_SLA_CHECK=900
# GUARDIAN_SCHEDULE_ALERT_RULES=900
# GUARDIAN_SCHEDULE_RISK_SCORES="0 2 * * *"
# GUARDIAN_SCHEDULE_REPORT_CLEANUP="0 3 * * *"
# GUARDIAN_SCHEDULE_HISTORY_CLEANUP="30 3 * * *"
# GUARDIAN_SCHEDULE_ASSET_INVENTORY="30 4 * * *"
# GUARDIAN_SCHEDULE_OVERDUE_ASSESSMENTS="0 8 * * *"
# GUARDIAN_SCHEDULE_EXPIRING_EXCEPTIONS="0 8 * * 1"
# GUARDIAN_SCHEDULE_USER_SCHEDULES=60

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# guardian logs to the console only.
LOG_LEVEL=INFO
# json, or anything else for a plain line.
LOG_FORMAT=json

# Sentry error tracking: off unless a DSN is set.
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=development

# false makes /metrics/ answer 404. docker-compose.yml does not pass it: in
# the stack the route is always served.
# PROMETHEUS_ENABLED=true

# Not here any more, because nothing read them (#665): the scanner, ticketing,
# Slack and Teams blocks (NESSUS_*, QUALYS_*, OPENVAS_*, RAPID7_*, JIRA_*,
# SERVICENOW_*, SLACK_*, TEAMS_*), the risk weights, DEFAULT_COMPLIANCE_FRAMEWORKS,
# MAX_CONCURRENT_SCANS, SCAN_TIMEOUT_SECONDS, BULK_OPERATIONS_BATCH_SIZE,
# CACHE_TIMEOUT_SECONDS, WILDBOX_API_URL, WILDBOX_API_KEY, WILDBOX_DATA_URL and
# WILDBOX_DATA_API_KEY, which settings.py read into dictionaries no code used;
# and some forty more this file listed that settings.py never read at all
# (DB_*, JWT_*, RATE_LIMIT_*, SESSION_*, CSRF_*, AWS_*, AZURE_*, GCP_*,
# BACKUP_*, ASSET_DISCOVERY_*, LOG_FILE, PROMETHEUS_PORT).
