# Open Security Data - environment of the data service
#
# The service reads its settings from the environment (app/config.py); it
# loads no .env file itself. Every variable below is one its code reads. In
# the full stack they come from the root .env through docker-compose.yml.

# Only "development" is a development environment: the API schema pages are
# served and SECRET_KEY, DATABASE_URL may be missing. With any other value, or
# none, the service refuses to start without them, and with DEBUG=true.
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql://secdata:CHANGE_ME@localhost:5432/securitydata
DB_POOL_SIZE=20
DB_POOL_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# API server, when started with `python -m app.api.main`
API_HOST=0.0.0.0
API_PORT=8002

# CORS: comma-separated origins
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000

# Sources the scheduler collects at the same time
MAX_CONCURRENT_COLLECTORS=10

# Security
# Required outside development.
SECRET_KEY=your-secret-key-change-in-production
# Required: the service accepts only requests that carry it with the caller's
# identity, as the gateway forwards them. The same value as the gateway's.
GATEWAY_INTERNAL_SECRET=
# Indicators or telemetry events accepted in one request
MAX_BATCH_SIZE=1000

# Logging, to the console
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Not here any more, because nothing read them (#665): REDIS_* (the service
# uses no Redis), API_WORKERS and the other API_* tuning values, RATE_LIMIT_*,
# COLLECTION_* and EXTERNAL_RATE_LIMIT_* (a source's timeout, rate limit and
# schedule are fields of the source), VALIDATE_COLLECTION_DATA,
# SKIP_DUPLICATES, DATA_RETENTION_DAYS, ARCHIVE_AFTER_DAYS, CLEANUP_INTERVAL,
# FILE_STORAGE_PATH, MAX_FILE_SIZE, BACKUP_*, JWT_*, MAX_QUERY_SIZE,
# LOG_FILE_*, LOG_MAX_BYTES, LOG_BACKUP_COUNT, LOG_JSON_FORMAT, SENTRY_*,
# MONITORING_ENABLED, METRICS_PORT, HEALTH_CHECK_*, PROMETHEUS_* and the keys
# of external services. DB_MAX_OVERFLOW was a misspelling of DB_POOL_OVERFLOW.
